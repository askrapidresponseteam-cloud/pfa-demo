# Copy these names into Vercel Project Settings > Environment Variables.
# Never put real values in Git. Use Preview and Production values separately.
CCAVENUE_MERCHANT_ID=
CCAVENUE_ACCESS_CODE=
CCAVENUE_WORKING_KEY=
CCAVENUE_MODE=production

# International (USD) donations, memberships and Give/Send. Required only if
# offering USD. CCAVENUE_USD_MERCHANT_ID is optional - leave unset if CCAvenue
# gave you the same Merchant ID for both currencies, only a different Access
# Code/Working Key. Set it only if CCAvenue issued a fully separate sub-account.
CCAVENUE_USD_MERCHANT_ID=
CCAVENUE_USD_ACCESS_CODE=
CCAVENUE_USD_WORKING_KEY=

# Firebase Admin SDK credentials. Use either the three fields below or
# FIREBASE_SERVICE_ACCOUNT_JSON as one Vercel Secret.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Production: https://peopleforanimalsindia.org
# Preview: set this to the preview URL while testing callbacks.
PUBLIC_SITE_URL=
# PFA Store / Paws & Tails. Create this token in Shopify's Headless
# sales channel and publish the PFA catalogue products to that channel.
PFA_SHOPIFY_STORE_DOMAIN=sg37v1-ta.myshopify.com
PFA_SHOPIFY_STOREFRONT_API_VERSION=2026-07
PFA_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Use this instead only if Paws & Tails gives PFA a server-side private token.
# PFA_SHOPIFY_STOREFRONT_PRIVATE_ACCESS_TOKEN=

# Live product catalogue shown on store.html (api/paws-catalog.js). Defaults
# shown are already correct for Paws & Tails; only override if that changes.
# PAWS_SHOPIFY_DOMAIN=sg37v1-ta.myshopify.com
# PAWS_STOREFRONT_DOMAIN=https://pawsandtails24.com
# Leave unset (strict vegetarian-food filtering) unless PFA explicitly wants
# every food product included regardless of the vegetarian check.
# PAWS_INCLUDE_ALL_FOOD=true

# --- Caretaker Card ---
# Transactional email (any provider with a JSON API; the default shape is Resend's)
PFA_MAIL_API_KEY=
PFA_MAIL_FROM="People for Animals <cards@peopleforanimalsindia.org>"
PFA_MAIL_REPLY_TO=
PFA_MAIL_ENDPOINT=https://api.resend.com/emails
# Bearer token for admin shipment updates and the email retry worker
PFA_ADMIN_TOKEN=

# Paws & Tails store (Shopify)
PFA_SHOPIFY_STORE_DOMAIN=sg37v1-ta.myshopify.com
PFA_SHOPIFY_STOREFRONT_API_VERSION=2026-07
PFA_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
PFA_SHOPIFY_WEBHOOK_SECRET=
PFA_SHOPIFY_ADMIN_TOKEN=
