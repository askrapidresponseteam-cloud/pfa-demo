{
  "cleanUrls": true,
  "buildCommand": "node scripts/build-catalog.js && node scripts/minify.js",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/network.html",
      "destination": "/report.html"
    },
    {
      "source": "/report",
      "destination": "/report.html"
    },
    {
      "source": "/ask",
      "destination": "/ask.html"
    },
    {
      "source": "/careers",
      "destination": "/careers.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__route=:path*"
    },
    {
      "source": "/products/:handle",
      "destination": "/api/index?__route=product-page&handle=:handle"
    }
  ],
  "redirects": [
    {
      "source": "/the-wire.html",
      "destination": "/newsroom.html",
      "permanent": true
    },
    {
      "source": "/the-wire",
      "destination": "/newsroom.html",
      "permanent": true
    },
    {
      "source": "/dispatch.html",
      "destination": "/newsroom.html",
      "permanent": true
    },
    {
      "source": "/dispatch",
      "destination": "/newsroom.html",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/caregiver/email-worker",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/pfa-store-reconcile",
      "schedule": "0 4 * * *"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{product.html,lib/catalog-snapshot.json}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(self), fullscreen=(self \"https://www.youtube.com\" \"https://player.vimeo.com\"), payment=(self \"https://api.razorpay.com\" \"https://checkout.razorpay.com\"), usb=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://checkout.razorpay.com https://cdn.jsdelivr.net https://www.youtube.com https://s.ytimg.com https://player.vimeo.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cdn.shopify.com https://*.myshopify.com https://images.pexels.com https://filmfederation.in https://i.ytimg.com https://commondatastorage.googleapis.com https://peopleforanimalsindia.org https://www.peopleforanimalsindia.org; font-src 'self' data:; connect-src 'self' https://api.postalpincode.in https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://api.razorpay.com https://lumberjack.razorpay.com https://cdn.jsdelivr.net https://huggingface.co https://*.huggingface.co https://*.hf.co; frame-src https://api.razorpay.com https://checkout.razorpay.com https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://www.facebook.com https://www.instagram.com; media-src 'self' blob: https://commondatastorage.googleapis.com https://filmfederation.in; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://secure.ccavenue.com https://test.ccavenue.com https://checkout.razorpay.com; frame-ancestors 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/(.*)\\.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/home/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|json|svg|xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/admin(.html)?",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
